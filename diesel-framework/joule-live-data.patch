+// ==========================================================
+// LIVE FUEL DATA
+// Diesel cover and Brent are refreshed every 6 hours by the diesel import
+// reduction framework (github.com/ajcbWIPs/energy-policy). If the fetch
+// fails, the April 2026 values above stay on screen.
+// ==========================================================
+const LIVE_DATA_URL = 'https://raw.githubusercontent.com/ajcbWIPs/energy-policy/main/diesel-framework/data/live.json';
+
+async function loadLiveFuelData() {
+    try {
+        const res = await fetch(LIVE_DATA_URL, { cache: 'no-store' });
+        if (!res.ok) return;
+        const ind = (await res.json()).indicators || {};
+        const stock = ind.diesel_stock;
+        if (stock && stock.diesel_days) {
+            const days = Math.round(stock.diesel_days);
+            STATE.fuelDaysDiesel = days;
+            document.querySelectorAll('[data-live="diesel-days"]').forEach(el => { el.textContent = days + ' days'; });
+            document.querySelectorAll('[data-live="diesel-days-num"]').forEach(el => { el.textContent = days; });
+        }
+        const brent = ind.brent_usd_bbl;
+        if (brent && brent.value) {
+            STATE.brent = brent.value;
+            document.querySelectorAll('[data-live="brent-usd"]').forEach(el => { el.textContent = 'US$' + brent.value.toFixed(2); });
+            document.querySelectorAll('[data-live="brent-num"]').forEach(el => { el.textContent = brent.value.toFixed(2); });
+        }
+    } catch (e) {
+        // Network or parse failure: keep the built-in April 2026 values.
+    }
+}
+
+loadLiveFuelData();
 tickLiveUpdate();
 setInterval(tickLiveUpdate, 12000);
 
